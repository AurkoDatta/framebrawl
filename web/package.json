{
  "name": "framebrawl-web",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "cargo build --release -p fb-wasm --target wasm32-unknown-unknown && wasm-bindgen --target web --out-dir src/wasm ../target/wasm32-unknown-unknown/release/fb_wasm.wasm",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  }
}
